{
  "name": "codedoc-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "antd": "^6.3.4",
    "axios": "^1.6.2",
    "dayjs": "^1.11.20",
    "github-markdown-css": "^5.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\"",
    "test": "react-scripts test --watchAll=false",
    "test:unit": "react-scripts test --watchAll=false --runInBand src/utils/__tests__ src/components/__tests__ src/contexts/__tests__",
    "test:scenario": "react-scripts test --watchAll=false --runInBand src/pages/__tests__",
    "test:coverage": "react-scripts test --watchAll=false --runInBand --coverage",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "react-scripts": "^5.0.1"
  },
  "proxy": "http://localhost:8000",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/*.test.{ts,tsx}",
      "!src/index.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 20,
        "lines": 40,
        "statements": 40
      }
    }
  }
}
