# API URL для фронтенда
REACT_APP_API_URL=http://localhost:8000

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production-2024
REFRESH_SECRET_KEY=your-super-refresh-secret-key-change-in-production-2024
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite Database Configuration
DATABASE_URL=sqlite:///./app.db

# LM Studio Configuration
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=qwen2.5-coder-1.5b-instruct
LM_STUDIO_TIMEOUT=60
LM_STUDIO_TEMPERATURE=0.1

# S3 / Object Storage Configuration (для MinIO или AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=codedoc-files
S3_REGION=us-east-1

# File upload limits
MAX_FILE_SIZE=10485760  # 10MB в байтах
ALLOWED_FILE_TYPES=.pdf,.txt,.md,.json,.zip,.py,.js,.ts

# Другие настройки
MAX_FILES_TO_ANALYZE=50
ENVIRONMENT=development